{
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",

  "C_Cpp.intelliSenseEngine": "disabled",
  "C_Cpp.autocomplete": "disabled",
  "C_Cpp.errorSquiggles": "disabled",

  "clangd.enable": true,
  "clangd.checkUpdates": false,
  "clangd.arguments": [
    "--background-index",
    "--clang-tidy=false",
    "--header-insertion=never"
  ],

  "clang-format.executable": "${workspaceRoot}/tools/clang-format/clang-format.exe",
  "clang-format.style": "file",
  "clang-format.language.csharp.enable": false,

  "[cpp]": {
    "editor.defaultFormatter": "xaver.clang-format",
    "editor.formatOnSave": true
  },
  "[c]": {
    "editor.defaultFormatter": "xaver.clang-format",
    "editor.formatOnSave": true
  },
  "[csharp]": {
    "editor.defaultFormatter": "anysphere.csharp",
    "editor.formatOnSave": true
  },

  "csharp.format.enable": true,
  "dotnet.defaultSolution": "src/tests/managed/managed.sln",

  "files.associations": {
    "*.h": "cpp",
    "build_config.h": "cpp"
  },

  "cmake.sourceDirectory": "${workspaceFolder}/src/runtime"
}
