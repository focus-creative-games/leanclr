<Project>
  <PropertyGroup>
    <LeanClrRepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))</LeanClrRepoRoot>
    <LeanClrOutRoot Condition="'$(LEANCLR_OUT_ROOT)' != ''">$([System.IO.Path]::GetFullPath('$(LEANCLR_OUT_ROOT)'))</LeanClrOutRoot>
    <LeanClrOutRoot Condition="'$(LeanClrOutRoot)' == ''">$(LeanClrRepoRoot)out</LeanClrOutRoot>
  </PropertyGroup>

  <!-- Non-SDK (legacy) projects: base paths only; OutputPath set in Directory.Build.targets -->
  <PropertyGroup Condition="'$(UsingMicrosoftNETSdk)' != 'true'">
    <BaseOutputPath>$(LeanClrOutRoot)\dotnet\$(MSBuildProjectName)\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(LeanClrOutRoot)\dotnet\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <!-- SDK-style projects -->
  <PropertyGroup Condition="'$(UsingMicrosoftNETSdk)' == 'true'">
    <BaseOutputPath>$(LeanClrOutRoot)\dotnet\$(MSBuildProjectName)\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(LeanClrOutRoot)\dotnet\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
