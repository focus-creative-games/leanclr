# Run at configure time and in CTest; no Python dependency for embedders.
function(leanclr_verify_layers root)
    set(core_dirs alloc codegen core gc interp log metadata misc profile public public_impl utils vm)
    set(core_files "${root}/bcl/adapter.h")
    foreach(dir ${core_dirs})
        file(GLOB_RECURSE files "${root}/${dir}/*.cpp" "${root}/${dir}/*.h" "${root}/${dir}/*.inc")
        list(APPEND core_files ${files})
    endforeach()
    foreach(path ${core_files})
        file(STRINGS "${path}" includes REGEX "^[ \t]*#[ \t]*include[ \t]+[\"<]")
        foreach(line ${includes})
            string(TOLOWER "${line}" dependency)
            if(dependency MATCHES "[\"<]([^\"<>]*/)?(bcl/mono/|bcl/coreclr-net10/|mono/|icalls/|intrinsics/|pinvokes/|platform/|windows\\.h|unistd\\.h)")
                message(FATAL_ERROR "Runtime core must use BCL/host contracts: ${path}: ${line}")
            endif()
        endforeach()
    endforeach()
    file(GLOB_RECURSE host_files "${root}/host/*.cpp" "${root}/host/*.h" "${root}/platform/*.cpp" "${root}/platform/*.h")
    foreach(path ${host_files})
        file(STRINGS "${path}" includes REGEX "^[ \t]*#[ \t]*include[ \t]+[\"<]")
        foreach(line ${includes})
            string(TOLOWER "${line}" dependency)
            if(dependency MATCHES "[\"<]([^\"<>]*/)?(vm/|metadata/|bcl/|icalls/|intrinsics/|pinvokes/|vmutils/)")
                message(FATAL_ERROR "Host services cannot depend on managed/BCL objects: ${path}: ${line}")
            endif()
        endforeach()
    endforeach()
endfunction()
if(DEFINED LEANCLR_LAYER_ROOT)
    leanclr_verify_layers("${LEANCLR_LAYER_ROOT}")
endif()
