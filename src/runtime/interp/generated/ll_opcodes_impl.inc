bool OpCodes::validate_operands(OpCodeEnum opcode, const InstructionOperands& operands)
{
    switch (opcode)
    {
    case OpCodeEnum::Illegal:
        return true;
    case OpCodeEnum::Nop:
        return true;
    case OpCodeEnum::ProfileAddCost:
        return true;
    case OpCodeEnum::InitLocals:
        return operands.locals_offset <= UINT16_MAX && operands.size <= UINT16_MAX;
    case OpCodeEnum::Arglist:
        return true;
    case OpCodeEnum::LdLocI1:
        return operands.first != nullptr && operands.first->eval_stack_offset <= UINT16_MAX && operands.destination != nullptr && operands.destination->eval_stack_offset <= UINT16_MAX;
    case OpCodeEnum::LdLocU1:
        return operands.first != nullptr && operands.first->eval_stack_offset <= UINT16_MAX && operands.destination != nullptr && operands.destination->eval_stack_offset <= UINT16_MAX;
    case OpCodeEnum::LdLocI2:
        return operands.first != nullptr && operands.first->eval_stack_offset <= UINT16_MAX && operands.destination != nullptr && operands.destination->eval_stack_offset <= UINT16_MAX;
    case OpCodeEnum::LdLocU2:
        return operands.first != nullptr && operands.first->eval_stack_offset <= UINT16_MAX && operands.destination != nullptr && operands.destination->eval_stack_offset <= UINT16_MAX;
    case OpCodeEnum::LdLocI4:
        return operands.first != nullptr && operands.first->eval_stack_offset <= UINT16_MAX && operands.destination != nullptr && operands.destination->eval_stack_offset <= UINT16_MAX;
    case OpCodeEnum::LdLocI8:
        return operands.first != nullptr && operands.first->eval_stack_offset <= UINT16_MAX && operands.destination != nullptr && operands.destination->eval_stack_offset <= UINT16_MAX;
    case OpCodeEnum::LdLocAny:
        return operands.first != nullptr && operands.first->eval_stack_offset <= UINT16_MAX && operands.destination != nullptr && operands.destination->eval_stack_offset <= UINT16_MAX && operands.size <= UINT16_MAX;
    case OpCodeEnum::LdLoca:
        return operands.first != nullptr && operands.first->eval_stack_offset <= UINT16_MAX && operands.destination != nullptr && operands.destination->eval_stack_offset <= UINT16_MAX;
    case OpCodeEnum::StLocI1:
        return operands.first != nullptr && operands.first->eval_stack_offset <= UINT16_MAX && operands.destination != nullptr && operands.destination->eval_stack_offset <= UINT16_MAX;
    case OpCodeEnum::StLocI2:
        return operands.first != nullptr && operands.first->eval_stack_offset <= UINT16_MAX && operands.destination != nullptr && operands.destination->eval_stack_offset <= UINT16_MAX;
    case OpCodeEnum::StLocI4:
        return operands.first != nullptr && operands.first->eval_stack_offset <= UINT16_MAX && operands.destination != nullptr && operands.destination->eval_stack_offset <= UINT16_MAX;
    case OpCodeEnum::StLocI8:
        return operands.first != nullptr && operands.first->eval_stack_offset <= UINT16_MAX && operands.destination != nullptr && operands.destination->eval_stack_offset <= UINT16_MAX;
    case OpCodeEnum::StLocAny:
        return operands.first != nullptr && operands.first->eval_stack_offset <= UINT16_MAX && operands.destination != nullptr && operands.destination->eval_stack_offset <= UINT16_MAX && operands.size <= UINT16_MAX;
    case OpCodeEnum::LdNull:
        return operands.destination != nullptr && operands.destination->eval_stack_offset <= UINT16_MAX;
    case OpCodeEnum::LdcI4I2:
        return operands.destination != nullptr && operands.destination->eval_stack_offset <= UINT16_MAX;
    case OpCodeEnum::LdcI4I4:
        return operands.destination != nullptr && operands.destination->eval_stack_offset <= UINT16_MAX;
    case OpCodeEnum::LdcI8I2:
        return operands.destination != nullptr && operands.destination->eval_stack_offset <= UINT16_MAX;
    case OpCodeEnum::LdcI8I4:
