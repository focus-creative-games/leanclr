    <IlFile Include="ILTests\Instructions\*.il" />
    <PackageReference Include="ILAsm" Version="9.4.0" GeneratePathProperty="true" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="EnsureLegacyILAsmRestored" BeforeTargets="BuildLegacyIlAssembly">
    <Error Condition="'$(PkgILAsm)' == '' Or !Exists('$(PkgILAsm)\build\net\ILAsm.targets')"
           Text="ILAsm NuGet package is missing. Run 'dotnet restore' on managed-net10.sln." />
  </Target>

  <Target Name="BuildLegacyIlAssembly" BeforeTargets="ResolveAssemblyReferences">
    <PropertyGroup>
      <IlNativeOutput>$(OutputPath)$(IlNativeAssemblyName).dll</IlNativeOutput>
      <_IlAsmExe Condition="'$(Platform)' == 'x86'">$(PkgILAsm)\bin\Win.x86\ilasm.exe</_IlAsmExe>
      <_IlAsmExe Condition="'$(_IlAsmExe)' == ''">$(PkgILAsm)\bin\Win.x64\ilasm.exe</_IlAsmExe>
      <_IlSources>@(IlFile->'&quot;$(MSBuildProjectDirectory)\%(Identity)&quot;', ' ')</_IlSources>
    </PropertyGroup>
    <MakeDir Directories="$(OutputPath)" />
    <Exec Command="&quot;$(_IlAsmExe)&quot; /dll /output:&quot;$(IlNativeOutput)&quot; /quiet $(_IlSources)" />
    <ItemGroup>
      <Reference Include="$(IlNativeAssemblyName)">
        <HintPath>$(IlNativeOutput)</HintPath>
        <Private>false</Private>
      </Reference>
    </ItemGroup>
  </Target>

</Project>
