<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <AssemblyName>CoreTests</AssemblyName>
    <RootNamespace>CoreTests</RootNamespace>
    <!-- 禁止自动引用系统 mscorlib -->
    <NoStandardLib>true</NoStandardLib>
    <NoConfig>true</NoConfig>
    <ProjectGuid>{A098E4A9-8B0E-4612-A75E-0AE2061E70FF}</ProjectGuid>
    <TargetFrameworkProfile />
  </PropertyGroup>
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup>
    <!-- CoreTests contains many intentionally "unreachable"/"unused" paths for instruction coverage.
         Suppress noisy compiler warnings to keep CI/build output readable. -->
    <NoWarn>CS0162;CS0219;CS0168;CS1522;CS0169;CS0649</NoWarn>
    <WarningLevel>0</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>portable</DebugType>
    <DefineConstants>
    </DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- Auto-include all C# sources under this project directory (MSBuild 15.8+ / VS 2017 15.8+) -->
    <Compile Include="**\*.cs" />
    <Compile Include="..\SharedTests\**\*.cs">
      <Link>Shared\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <!-- <Reference Include="netstandard">
      <HintPath>$(ProjectDir)\..\..\..\..\..\netframework\NetStandard\ref\2.1.0\netstandard.dll</HintPath>
        <Aliases>global</Aliases>
    </Reference> -->
    <Reference Include="mscorlib">
      <HintPath>$(ProjectDir)\..\..\..\libraries\dotnetframework4.x\mscorlib.dll</HintPath>
    </Reference>
    <Reference Include="System.Core">
      <HintPath>$(ProjectDir)\..\..\..\libraries\dotnetframework4.x\System.Core.dll</HintPath>
    </Reference>
    <Reference Include="System">
      <HintPath>$(ProjectDir)\..\..\..\libraries\dotnetframework4.x\System.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Common\Common.csproj">
      <Project>{aa467143-bba4-4b54-95e5-1d0f1099f380}</Project>
      <Name>Common</Name>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
